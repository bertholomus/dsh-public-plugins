{
  "name": "dsh-plugin-notifications",
  "version": "0.1.0",
  "description": "System notifications for DSH when its window is hidden or unfocused, for other plugins to call.",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "icon.svg", "icon.png", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": { "node": ">=20" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-typert-protocol": "*"
  }
}
