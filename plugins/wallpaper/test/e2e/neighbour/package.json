{
  "name": "dsh-plugin-wallpaper-neighbour",
  "version": "0.0.0",
  "description": "A stand-in neighbour for Wallpaper's real-DSH test: one panel entry with its own page, and one footer button, the way other plugins add theirs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
