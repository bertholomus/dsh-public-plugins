{
  "name": "dsh-plugin-categories",
  "version": "0.1.0",
  "description": "Group your workspaces into categories in DSH's session list.",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "scripts", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-typert-protocol": "*"
  }
}
