{
  "name": "dsh-plugin-discord",
  "version": "0.2.0",
  "description": "A Discord bot for your own channels: each conversation gets a thread and its own DSH session, and the agent answers in that thread.",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 \"test/unit/*.test.mjs\"",
    "e2e": "node scripts/e2e.mjs",
    "e2e:install": "node scripts/e2e-install.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
