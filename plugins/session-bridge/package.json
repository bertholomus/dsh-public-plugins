{
  "name": "dsh-plugin-session-bridge",
  "version": "0.4.0",
  "description": "Lets scripts and scheduled jobs on this Mac start, prompt, steer and read DSH sessions, and retry them safely.",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": ">=22" },
  "peerDependencies": { "@deepseek-ai/schemastery": "^3.18.1", "@deepseek-ai/dsh-home-paths": "*" }
}
